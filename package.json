{
  "name": "cafe-ordering-fullstack",
  "version": "0.1.0",
  "description": "Complete cafe ordering system with admin and customer interfaces",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm start",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "db:generate": "cd frontend && npm run db:generate",
    "db:push": "cd frontend && npm run db:push",
    "db:studio": "cd frontend && npm run db:studio",
    "db:up": "cd frontend && npm run db:up",
    "db:down": "cd frontend && npm run db:down"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}